---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ProjectRow from "../components/ProjectRow.astro";
import RenderTile from "../components/RenderTile.astro";
import { PROJECTS, RENDERS } from "../data/content";

const featuredProjects = PROJECTS.filter((p) => p.status === "actif").slice(0, 2);
const featuredRenders = RENDERS.slice(0, 3);
---
<Base>
  <SiteHeader />

  <section class="intro container">
    <h1 class="lede">
      Élève ingénieur à <em>Télécom SudParis</em>, à la recherche d'un poste en
      R&D&nbsp;VFX. Je travaille à l'intersection du <em>machine learning</em> et
      du rendu&nbsp;: moteurs, outils Blender, synthèse de mouvement.
    </h1>
    <dl class="facts mono">
      <div><dt>Formation</dt><dd>Ingénieur généraliste du numérique, Télécom SudParis — diplômé en novembre 2026</dd></div>
      <div><dt>Disponible</dt><dd>immédiatement — stage, CDD ou CDI</dd></div>
      <div><dt>Mobilité</dt><dd>Paris — ouvert à la France entière et à l'international</dd></div>
      <div><dt>Domaines</dt><dd>ML, rendering, motion</dd></div>
    </dl>
  </section>

  <section class="feature container">
    <div class="section-head">
      <h2>Sélection — R&D</h2>
      <a href="/projets" class="mono muted see-all">tous les projets ({PROJECTS.length}) →</a>
    </div>
    <ol class="proj-list">
      {featuredProjects.map((p) => <ProjectRow project={p} />)}
    </ol>
  </section>

  <section class="feature container">
    <div class="section-head">
      <h2>Sélection — Rendus</h2>
      <a href="/rendus" class="mono muted see-all">galerie complète ({RENDERS.length}) →</a>
    </div>
    <div class="rend-grid">
      {featuredRenders.map((r) => <RenderTile render={r} />)}
    </div>
  </section>

  <SiteFooter />
</Base>

<style>
  .intro {
    display: grid;
    /* colonne de droite bornée : les valeurs de parcours sont longues et, en
       `auto`, elles reprenaient la place du lede au lieu de passer à la ligne */
    grid-template-columns: minmax(0, 1fr) minmax(0, 32ch);
    gap: clamp(24px, 4vw, 60px);
    align-items: end;
    padding-block: clamp(72px, 10vw, 130px) clamp(40px, 5vw, 64px);
  }
  .lede {
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 400;
    max-width: 22ch;
  }
  .lede em { font-style: italic; color: var(--accent-ink); }
  .facts {
    display: grid; gap: 10px;
    color: var(--muted);
    font-size: 0.82rem; line-height: 1.4;
  }
  .facts > div { display: grid; grid-template-columns: 82px minmax(0, 1fr); gap: 10px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; color: var(--ink-2); text-wrap: pretty; }
  @media (max-width: 720px) {
    .intro { grid-template-columns: 1fr; }
    .lede { max-width: none; }
  }

  .feature { padding-block: clamp(20px, 3vw, 32px) clamp(40px, 5vw, 60px); }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-block: clamp(24px, 4vw, 44px) 20px;
    border-top: 1px solid var(--line);
  }
  .section-head h2 {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .see-all {
    font-size: 0.82rem;
    transition: color 180ms ease-out;
  }
  .see-all:hover { color: var(--accent-ink); }

  .proj-list { list-style: none; padding: 0; margin: 0; }

  .rend-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
  }
</style>
