---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import RenderTile from "../../components/RenderTile.astro";
import { RENDERS } from "../../data/content";

export function getStaticPaths() {
  return RENDERS.map((r) => ({ params: { slug: r.slug }, props: { render: r } }));
}

const { render: r } = Astro.props;
const others = RENDERS.filter((x) => x.slug !== r.slug).slice(0, 3);
---
<Base title={`${r.title} — Nicolas Scheer`} description={r.blurb}>
  <SiteHeader />

  <section class="head container">
    <div class="bread mono muted">
      <a href="/">accueil</a> <span>/</span> <a href="/rendus">rendus</a> <span>/</span> <span>{r.slug}</span>
    </div>
    <h1><em>{r.title}</em></h1>
    <div class="meta mono muted">
      <span>{r.tools.join(" · ")}</span>
      <span aria-hidden="true">·</span>
      <span>{r.loop}</span>
    </div>
    <p class="blurb">{r.blurb}</p>
  </section>

  <section class="container player">
    <video
      class="main-video"
      src={`/media/renders/${r.slug}.mp4`}
      controls
      loop
      playsinline
      preload="metadata"
    ></video>
  </section>

  {others.length > 0 && (
    <section class="container more">
      <div class="section-head">
        <h2>Autres rendus</h2>
        <a href="/rendus" class="mono muted see-all">galerie complète →</a>
      </div>
      <div class="rend-grid">
        {others.map((o) => <RenderTile render={o} />)}
      </div>
    </section>
  )}

  <SiteFooter />
</Base>

<style>
  .head {
    padding-block: clamp(56px, 8vw, 100px) clamp(32px, 4vw, 48px);
    display: grid;
    gap: 14px;
  }
  .bread { font-size: 0.8rem; display: flex; gap: 8px; }
  .bread a { color: var(--muted); }
  .bread a:hover { color: var(--accent-ink); }
  .bread span:last-child { color: var(--ink-2); }
  .head h1 {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
    font-weight: 500;
    line-height: 1.02;
    padding-bottom: 0.08em;
  }
  .head h1 em { font-style: italic; }
  .meta { display: flex; gap: 10px; font-size: 0.86rem; }
  .blurb {
    font-size: var(--step-1p);
    color: var(--ink-2);
    max-width: 58ch;
    line-height: 1.5;
  }

  .player { padding-bottom: clamp(48px, 6vw, 80px); }
  .main-video {
    width: 100%;
    border-radius: 6px;
    background: var(--ink);
    aspect-ratio: 16/9;
  }

  .more { padding-bottom: clamp(80px, 10vw, 120px); }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-block: clamp(24px, 4vw, 44px) 20px;
    border-top: 1px solid var(--line);
  }
  .section-head h2 {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .see-all { font-size: 0.82rem; transition: color 180ms ease-out; }
  .see-all:hover { color: var(--accent-ink); }
  .rend-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
  }
</style>
