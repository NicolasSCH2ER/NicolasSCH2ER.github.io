---
import type { Project } from "../data/content";

/*
  Vignette d'un projet : image fixe au chargement, clip lu au survol.
  Les listes (accueil, /projets) ne doivent rien telecharger de lourd — la
  video n'est demandee qu'a l'intention de l'utilisateur (preload="none").
*/
interface Props {
  project: Project;
  aspect?: string;
  class?: string;
  lang?: "fr" | "en";
}

const { project: p, aspect = "16/10", class: className, lang = "fr" } = Astro.props;
const altPrefix = lang === "en" ? "Preview" : "Aperçu";

const still = p.image;
const clip = p.videos?.find((v) => v.endsWith(".mp4"));
/* repli : un projet sans still dedie mais dont la galerie est en images */
const fallbackImage = still ?? p.videos?.find((v) => !v.endsWith(".mp4"));
---

{clip && still ? (
  <div class:list={["media-frame has-media", className]} style={`--media-aspect:${aspect}`}>
    <video
      src={clip}
      poster={still}
      muted
      loop
      playsinline
      preload="none"
      data-hover-clip
    ></video>
  </div>
) : fallbackImage ? (
  <div class:list={["media-frame has-media", className]} style={`--media-aspect:${aspect}`}>
    <img src={fallbackImage} alt={`${altPrefix} — ${p.title}`} loading="lazy" />
  </div>
) : (
  <div class:list={["media-frame ph", className]} style={`--media-aspect:${aspect}; --h:${p.hue}`}>
    <span class="stamp mono">still · {p.slug}</span>
  </div>
)}

<script>
  /* Lecture au survol et au focus clavier. Le conteneur est un <a>, donc on
     ecoute sur le lien parent pour couvrir la tabulation autant que la souris. */
  const clips = document.querySelectorAll<HTMLVideoElement>("[data-hover-clip]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduced) {
    clips.forEach((video) => {
      const zone = video.closest("a") ?? video.parentElement;
      if (!zone) return;

      const play = () => { video.play().catch(() => {}); };
      const stop = () => { video.pause(); video.currentTime = 0; };

      zone.addEventListener("mouseenter", play);
      zone.addEventListener("mouseleave", stop);
      zone.addEventListener("focusin", play);
      zone.addEventListener("focusout", stop);
      /* tactile : pas de survol, une pression lance la boucle */
      zone.addEventListener("touchstart", play, { passive: true });
    });
  }
</script>

<style>
  .media-frame {
    aspect-ratio: var(--media-aspect);
    border-radius: 6px;
  }
  .media-frame.has-media {
    overflow: hidden;
    background: var(--surface);
  }
  .media-frame.has-media img,
  .media-frame.has-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
