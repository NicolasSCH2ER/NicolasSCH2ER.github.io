---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import RenderTile from "../../components/RenderTile.astro";
import { PROJECTS_EN, RENDERS_EN } from "../../data/content.en";

const featuredProjects = PROJECTS_EN.filter((p) => p.status === "active").slice(0, 2);
const featuredRenders = RENDERS_EN.slice(0, 3);
---
<Base
  lang="en"
  title="Nicolas Scheer — R&D VFX"
  description="R&D VFX portfolio: ML, rendering engines, production tools."
>
  <SiteHeader lang="en" />

  <section class="intro container">
    <h1 class="lede">
      Engineering student at <em>Télécom SudParis</em>, looking for an
      R&D&nbsp;VFX position. I work at the intersection of <em>machine learning</em> and
      rendering: engines, Blender tools, motion synthesis.
    </h1>
    <dl class="facts mono">
      <div><dt>Education</dt><dd>Engineering degree, Télécom SudParis — High Tech Imaging specialization (imaging, vision, 3D) — graduating November 2026</dd></div>
      <div><dt>Available</dt><dd>immediately — internship, fixed-term or permanent</dd></div>
      <div><dt>Location</dt><dd>Paris — open to relocating within France or abroad</dd></div>
      <div><dt>Focus</dt><dd>ML, rendering, motion</dd></div>
    </dl>
  </section>

  <section class="feature container">
    <div class="section-head">
      <h2>Selection — R&D</h2>
      <a href="/en/projets" class="mono muted see-all">all projects ({PROJECTS_EN.length}) →</a>
    </div>
    <ol class="proj-list">
      {featuredProjects.map((p) => <ProjectRow project={p} base="/en" lang="en" />)}
    </ol>
  </section>

  <section class="feature container">
    <div class="section-head">
      <h2>Selection — Renders</h2>
      <a href="/en/rendus" class="mono muted see-all">full gallery ({RENDERS_EN.length}) →</a>
    </div>
    <div class="rend-grid">
      {featuredRenders.map((r) => <RenderTile render={r} base="/en" />)}
    </div>
  </section>

  <SiteFooter lang="en" />
</Base>

<style>
  .intro {
    display: grid;
    /* colonne de droite bornée : les valeurs de parcours sont longues et, en
       `auto`, elles reprenaient la place du lede au lieu de passer à la ligne */
    grid-template-columns: minmax(0, 1fr) minmax(0, 32ch);
    gap: clamp(24px, 4vw, 60px);
    align-items: end;
    padding-block: clamp(72px, 10vw, 130px) clamp(40px, 5vw, 64px);
  }
  .lede {
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 400;
    max-width: 22ch;
  }
  .lede em { font-style: italic; color: var(--accent-ink); }
  .facts {
    display: grid; gap: 10px;
    color: var(--muted);
    font-size: 0.82rem; line-height: 1.4;
  }
  .facts > div { display: grid; grid-template-columns: 82px minmax(0, 1fr); gap: 10px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; color: var(--ink-2); text-wrap: pretty; }
  @media (max-width: 720px) {
    .intro { grid-template-columns: 1fr; }
    .lede { max-width: none; }
  }

  .feature { padding-block: clamp(20px, 3vw, 32px) clamp(40px, 5vw, 60px); }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-block: clamp(24px, 4vw, 44px) 20px;
    border-top: 1px solid var(--line);
  }
  .section-head h2 {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .see-all {
    font-size: 0.82rem;
    transition: color 180ms ease-out;
  }
  .see-all:hover { color: var(--accent-ink); }

  .proj-list { list-style: none; padding: 0; margin: 0; }

  .rend-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
  }
</style>
