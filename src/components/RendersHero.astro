---
/*
  Hero WebGPU pour /rendus.
  - Particules GPU via compute shader TSL (three@webgpu)
  - Fallback dégradé statique si WebGPU absent
  - Boot paresseux via IntersectionObserver, aucun coût sur les autres pages
*/
---
<div class="hero" data-webgpu-hero aria-hidden="true">
  <div class="hero-fallback"></div>
  <canvas class="hero-canvas"></canvas>
  <div class="hero-fade"></div>
  <div class="hero-tag mono" data-status hidden></div>
</div>

<style>
  .hero {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    isolation: isolate;
  }
  .hero-fallback {
    position: absolute; inset: 0;
    background:
      radial-gradient(60% 45% at 30% 30%, oklch(0.75 0.10 42 / 0.35), transparent 65%),
      radial-gradient(50% 45% at 75% 60%, oklch(0.60 0.15 42 / 0.30), transparent 60%);
    opacity: 1;
    transition: opacity 800ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hero-canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  /* fondu vers le fond en bas → transition douce avant la grille */
  .hero-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    background: linear-gradient(to bottom, transparent, var(--bg) 85%);
    pointer-events: none;
    z-index: 1;
  }
  .hero[data-ready="1"] .hero-fallback { opacity: 0; }
  .hero[data-ready="1"] .hero-canvas   { opacity: 1; }

  .hero-tag {
    position: absolute;
    right: clamp(20px, 4vw, 40px);
    top: 20px;
    z-index: 2;
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--muted);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-canvas { display: none; }
    .hero-fallback { opacity: 1 !important; }
  }
</style>

<script>
  type HeroEl = HTMLElement & { __booted?: boolean };

  const roots = document.querySelectorAll<HeroEl>("[data-webgpu-hero]");
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  roots.forEach((root) => {
    const status = root.querySelector<HTMLElement>("[data-status]");
    // Les echecs restent silencieux : on garde le degrade de fallback sans
    // afficher de diagnostic au visiteur. Le tag n'apparait qu'en cas de succes.
    if (prefersReduced) return;
    if (!("gpu" in navigator)) return;

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && !root.__booted) {
          root.__booted = true;
          io.disconnect();
          boot(root, status).catch((err) => {
            console.warn("[hero] boot failed", err);
          });
        }
      }
    }, { rootMargin: "200px" });

    io.observe(root);
  });

  async function boot(root: HeroEl, status: HTMLElement | null) {
    const canvas = root.querySelector<HTMLCanvasElement>(".hero-canvas");
    if (!canvas) return;

    const THREE = await import("three/webgpu");
    const TSL = await import("three/tsl");
    const {
      Fn, If, uniform, float, vec3, hash, instancedArray, instanceIndex, vertexIndex, time
    } = TSL;

    const COUNT = 100000;
    const positions  = instancedArray(COUNT, "vec3");
    const velocities = instancedArray(COUNT, "vec3");

    const dt = uniform(0);
    const noiseScale = uniform(0.55);
    const flowSpeed = uniform(0.22);
    const damping = uniform(0.94);
    const boundR = uniform(5.2);

    const computeInit = Fn(() => {
      const p = positions.element(instanceIndex);
      const v = velocities.element(instanceIndex);
      p.x.assign(hash(instanceIndex.add(11)).sub(0.5).mul(8));
      p.y.assign(hash(instanceIndex.add(23)).sub(0.5).mul(4.5));
      p.z.assign(hash(instanceIndex.add(37)).sub(0.5).mul(2.2));
      v.assign(vec3(0));
    })().compute(COUNT);

    const computeUpdate = Fn(() => {
      const p = positions.element(instanceIndex);
      const v = velocities.element(instanceIndex);
      const s = noiseScale;
      const t = time.mul(flowSpeed);

      const fx = p.y.mul(s).add(t).sin().add(p.z.mul(s.mul(1.3)).sub(t).cos()).mul(0.5);
      const fy = p.z.mul(s.mul(1.1)).add(t).sin().add(p.x.mul(s.mul(0.9)).sub(t).cos()).mul(0.5);
      const fz = p.x.mul(s.mul(1.2)).add(t).sin().add(p.y.mul(s).sub(t).cos()).mul(0.5);
      const force = vec3(fx, fy, fz).mul(0.55);

      v.addAssign(force.mul(dt));
      v.mulAssign(damping);
      p.addAssign(v.mul(dt.mul(1.4)));

      const r = p.length();
      If(r.greaterThan(boundR), () => {
        p.x.assign(hash(instanceIndex.add(time.mul(41))).sub(0.5).mul(8));
        p.y.assign(hash(instanceIndex.add(time.mul(53))).sub(0.5).mul(4.5));
        p.z.assign(hash(instanceIndex.add(time.mul(67))).sub(0.5).mul(2.2));
        v.assign(vec3(0));
      });
    })().compute(COUNT);

    const rect = root.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    const w = Math.max(1, rect.width);
    const h = Math.max(1, rect.height);

    const camera = new THREE.PerspectiveCamera(38, w / h, 0.1, 100);
    camera.position.set(0, 0, 7);
    camera.lookAt(0, 0, 0);

    const scene = new THREE.Scene();
    scene.background = null;

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute("position", new THREE.Float32BufferAttribute(new Float32Array(COUNT * 3), 3));
    geometry.setDrawRange(0, COUNT);

    const material = new THREE.PointsNodeMaterial();
    material.positionNode = positions.element(vertexIndex);
    material.colorNode = vec3(float(0.42), float(0.18), float(0.10));
    material.sizeNode = float(2.4 * dpr);
    material.sizeAttenuation = false; // taille en pixels écran
    material.transparent = true;
    material.opacityNode = float(0.75);
    material.depthWrite = false;

    scene.add(new THREE.Points(geometry, material));

    const renderer = new THREE.WebGPURenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(dpr);
    renderer.setSize(w, h, false);
    renderer.setClearColor(0x000000, 0);

    try {
      await renderer.init();
    } catch (err) {
      console.warn("[hero] renderer.init failed", err);
      return;
    }

    renderer.compute(computeInit);

    const clock = new THREE.Clock();
    let running = true;

    const onVisibility = () => { running = !document.hidden; };
    document.addEventListener("visibilitychange", onVisibility);

    const ro = new ResizeObserver(() => {
      const r = root.getBoundingClientRect();
      if (r.width < 2 || r.height < 2) return;
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
      renderer.setSize(r.width, r.height, false);
    });
    ro.observe(root);

    root.dataset.ready = "1";
    if (status) {
      status.textContent = `${(COUNT / 1000) | 0}k · gpu`;
      status.hidden = false;
    }

    renderer.setAnimationLoop(() => {
      if (!running) return;
      dt.value = Math.min(clock.getDelta(), 1 / 30);
      renderer.compute(computeUpdate);
      renderer.render(scene, camera);
    });
  }
</script>
