---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { PROJECTS } from "../../data/content";
import ProjectMedia from "../../components/ProjectMedia.astro";
import ModelViewport from "../../components/ModelViewport.astro";

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project: p } = Astro.props;
const others = PROJECTS.filter((x) => x.slug !== p.slug).slice(0, 3);
---
<Base title={`${p.title} — Nicolas Scheer`} description={p.summary}>
  <SiteHeader />

  <section class="head container">
    <div class="bread mono muted">
      <a href="/">accueil</a> <span>/</span> <a href="/projets">projets</a> <span>/</span> <span>{p.slug}</span>
    </div>
    <div class="row-meta mono muted">
      <span>{p.year}</span>
      <span aria-hidden="true">·</span>
      <span>{p.tag}</span>
      <span class:list={["status", `status-${p.status.replace(/\s+/g, "-")}`]}>{p.status}</span>
    </div>
    <h1><em>{p.title}</em></h1>
    <p class="summary">{p.summary}</p>
    <ul class="stack mono">
      {p.stack.map((t) => <li>{t}</li>)}
    </ul>
  </section>

  {p.videos && p.videos.length > 1 ? (
    <section class="media media-wide">
      <p class="media-label mono muted">{p.mediaLabel ?? `${p.videos.length} rendus issus du projet`}</p>
      <div class="video-grid">
        {p.videos.map((v, i) => (
          <figure class="video-tile">
            {v.endsWith(".mp4") ? (
              <video src={v} autoplay muted loop playsinline preload="metadata" />
            ) : (
              <img src={v} alt={p.videoLabels?.[i] ?? `Rendu — ${p.title}`} loading="lazy" />
            )}
            {p.videoLabels?.[i] && <figcaption class="mono muted">{p.videoLabels[i]}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  ) : (
    <section class="media container">
      <ProjectMedia project={p} aspect="16/9" class="media-single" />
    </section>
  )}

  {p.model && (
    <section class="container viewport-section">
      <p class="media-label mono muted">viewport 3D — maillage réel exporté du projet, navigable à la souris</p>
      <ModelViewport
        src={p.model.src}
        poster={p.model.poster}
        label={p.model.label}
        hue={p.hue}
        aspect="16/9"
      />
    </section>
  )}

  <section class="container detail">
    <div class="detail-grid">
      <div class="detail-block">
        <h2 class="mono muted">Problème</h2>
        <p>{p.problem}</p>
      </div>
      <div class="detail-block">
        <h2 class="mono muted">Approche</h2>
        <p>{p.approach}</p>
      </div>
      <div class="detail-block">
        <h2 class="mono muted">Résultats</h2>
        <p>{p.results}</p>
      </div>
    </div>
    {p.github && (
      <a href={p.github} class="github-link mono" target="_blank" rel="noopener">voir le code →</a>
    )}
  </section>

  {others.length > 0 && (
    <section class="container more">
      <div class="section-head">
        <h2>Autres projets</h2>
        <a href="/projets" class="mono muted see-all">tous les projets →</a>
      </div>
      <ul class="more-list">
        {others.map((o) => (
          <li>
            <a href={`/projets/${o.slug}`} class="more-row">
              <span class="more-title"><em>{o.title}</em></span>
              <span class="more-summary muted">{o.summary}</span>
              <span class="more-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <SiteFooter />
</Base>

<style>
  .head {
    padding-block: clamp(56px, 8vw, 100px) clamp(28px, 4vw, 40px);
    display: grid;
    gap: 14px;
  }
  .bread { font-size: 0.8rem; display: flex; gap: 8px; }
  .bread a { color: var(--muted); }
  .bread a:hover { color: var(--accent-ink); }
  .bread span:last-child { color: var(--ink-2); }
  .row-meta { display: flex; gap: 10px; align-items: baseline; font-size: 0.82rem; }
  .head h1 {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
    font-weight: 500;
    line-height: 1.02;
    padding-bottom: 0.08em;
  }
  .head h1 em { font-style: italic; }
  .summary {
    font-size: var(--step-1p);
    color: var(--ink-2);
    max-width: 60ch;
    line-height: 1.5;
  }
  .stack {
    list-style: none; padding: 0; margin: 4px 0 0;
    display: flex; gap: 14px; flex-wrap: wrap;
    color: var(--muted); font-size: 0.82rem;
  }
  .stack li:not(:last-child)::after {
    content: " ·"; margin-left: 14px; color: var(--line-2);
  }
  .status { text-transform: lowercase; }
  .status-actif { color: var(--accent-ink); }
  .status-en-cours { color: var(--ink-2); }
  .status-archivé { color: var(--muted); }

  .media { padding-bottom: clamp(40px, 6vw, 64px); }
  :global(.media-single) { width: 100%; }

  .media-label {
    font-size: 0.78rem;
    margin-bottom: 16px;
  }
  /* galerie multi-rendus : sort volontairement du gabarit --container standard
     (plus de place pour comparer plusieurs simulations), mais garde une
     bordure de section comme les autres blocs pour rester lisible comme un
     choix délibéré plutôt qu'un décalage accidentel. */
  .media-wide {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    padding-top: clamp(24px, 4vw, 40px);
    border-top: 1px solid var(--line);
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(16px, 2.5vw, 28px);
  }
  .video-tile { display: grid; gap: 8px; }
  .video-tile video,
  .video-tile img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    border-radius: 6px;
    background: var(--ink);
  }
  .video-tile figcaption {
    font-size: 0.76rem;
    padding-inline: 2px;
  }

  .viewport-section { padding-bottom: clamp(32px, 5vw, 56px); }

  .detail { padding-bottom: clamp(48px, 6vw, 80px); }
  .detail-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 40px);
    padding-block: clamp(24px, 3vw, 36px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .detail-block h2 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 10px;
  }
  .detail-block p {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .github-link {
    display: inline-block;
    margin-top: 24px;
    font-size: 0.86rem;
    color: var(--ink);
    transition: color 180ms ease-out;
  }
  .github-link:hover { color: var(--accent-ink); }

  .more { padding-bottom: clamp(80px, 10vw, 120px); }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-block: clamp(24px, 4vw, 44px) 20px;
    border-top: 1px solid var(--line);
  }
  .section-head h2 {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .see-all { font-size: 0.82rem; transition: color 180ms ease-out; }
  .see-all:hover { color: var(--accent-ink); }
  .more-list { list-style: none; padding: 0; margin: 0; }
  .more-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 24px;
    gap: 20px;
    align-items: baseline;
    padding-block: 14px;
    border-top: 1px solid var(--line);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), color 180ms ease-out;
  }
  .more-row:hover { transform: translateX(6px); color: var(--accent-ink); }
  .more-title {
    font-family: var(--serif);
    font-size: var(--step-1p);
    font-weight: 500;
  }
  .more-title em { font-style: italic; }
  .more-summary {
    font-size: 0.86rem;
    max-width: 46ch;
    justify-self: end;
    text-align: right;
  }
  .more-arrow { font-size: 1.1rem; color: var(--muted); }
  .more-row:hover .more-arrow { color: var(--accent-ink); }

  @media (max-width: 800px) {
    .detail-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .more-row { grid-template-columns: 1fr 20px; }
    .more-summary { display: none; }
  }
</style>
